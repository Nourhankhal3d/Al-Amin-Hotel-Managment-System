NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/staff_dev
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/staff_dev
JWT_SECRET=replace_with_64_char_random_hex
